# Read by Django (python-dotenv) and by docker compose (env_file).
# Use KEY=value without spaces around '=' so both parsers agree.

# Django secret key. Generate with:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=

# Fernet key(s) used to encrypt wallet private keys. Comma separated; the first one
# encrypts, all of them decrypt (for key rotation). NEVER commit a real key, and back it up:
# losing it means losing every wallet. Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
WALLET_ENCRYPTION_KEYS=

# Set DEBUG=False in production, and list the host names the site is served on.
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# Needed for the admin when served behind HTTPS, e.g. https://wallet.example.com
CSRF_TRUSTED_ORIGINS=

# Redis used as Celery broker and as the shared cache for task locks.
# docker compose overrides this to point at its own redis service.
REDIS_URL=redis://localhost:6379/0

# PostgreSQL. Leave POSTGRES_HOST empty to use SQLite for local development;
# docker compose sets it to its own db service. The postgres container also reads
# POSTGRES_DB / POSTGRES_USER / POSTGRES_PASSWORD from this file to create the database.
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_DB=central_wallet
POSTGRES_USER=central_wallet
POSTGRES_PASSWORD=

# Public base URL for links in emails (verification, password reset). Required when DEBUG=False.
SITE_URL=
# Trusted reverse proxies in front of the app (for client IPs in throttling): 0 direct, 1 behind one proxy.
NUM_PROXIES=0
# Optional frontend page for password resets, e.g. https://app.example.com/reset?uid={uid}&token={token}
PASSWORD_RESET_URL=

# Two-factor authentication: withdrawals and transfers need it unless set to False.
REQUIRE_2FA_FOR_WITHDRAWAL=True
# Hours before a new saved withdrawal address can be used, and before turning whitelist mode off takes effect.
WITHDRAWAL_ADDRESS_COOLDOWN_HOURS=24
# Hours withdrawals and transfers stay paused after a password reset or after 2FA is turned off.
SECURITY_CHANGE_COOLDOWN_HOURS=24
# Wrong 2FA codes allowed per user within OTP_FAILURE_WINDOW seconds.
OTP_MAX_FAILURES=5
OTP_FAILURE_WINDOW=900
TOTP_ISSUER=DjangoCentralWallet

# SMTP. Leave EMAIL_HOST empty to print emails to the console (development).
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=noreply@example.com

# Port published by docker compose for the web app.
WEB_PORT=8000
