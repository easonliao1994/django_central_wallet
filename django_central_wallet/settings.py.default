# SECURITY WARNING: keep the secret key used in production secret!
SECRET_KEY = os.getenv('SECRET_KEY')

# Fernet key(s) used to encrypt wallet private keys at rest, comma separated.
# The first key encrypts; all keys are tried for decryption (key rotation).
WALLET_ENCRYPTION_KEYS = [k.strip() for k in os.getenv('WALLET_ENCRYPTION_KEYS', '').split(',') if k.strip()]

# Public base URL used in emailed links (verification, password reset), e.g. https://wallet.example.com.
# Set it in production: without it links are built from the request's Host header.
SITE_URL = os.getenv('SITE_URL', '').rstrip('/')
HAS_HTTPS = os.getenv('HAS_HTTPS', 'True').strip().lower() in ('1', 'true', 'yes', 'on')  # fallback scheme
# Optional frontend page for password resets; {uid} and {token} are filled in.
# Without it the email contains the uid and token to submit to /account/password/reset/.
PASSWORD_RESET_URL = os.getenv('PASSWORD_RESET_URL', '')



def env_bool(name, default=False):
    return os.getenv(name, str(default)).strip().lower() in ('1', 'true', 'yes', 'on')


def env_list(name, default=''):
    return [v.strip() for v in os.getenv(name, default).split(',') if v.strip()]


