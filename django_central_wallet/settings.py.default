# Database
# https://docs.djangoproject.com/en/4.2/ref/settings/#databases

# PostgreSQL when POSTGRES_HOST is set (Docker / production), SQLite otherwise.
# Production must use PostgreSQL: SQLite ignores select_for_update row locks.
if os.getenv('POSTGRES_HOST'):
    DATABASES = {
        'default': {
            'ENGINE': 'django.db.backends.postgresql',
            'HOST': os.getenv('POSTGRES_HOST'),
            'PORT': os.getenv('POSTGRES_PORT', '5432'),
            'NAME': os.getenv('POSTGRES_DB', 'central_wallet'),
            'USER': os.getenv('POSTGRES_USER', 'central_wallet'),
            'PASSWORD': os.getenv('POSTGRES_PASSWORD', ''),
            'CONN_MAX_AGE': 60,
        }
    }
else:
    DATABASES = {
        'default': {
            'ENGINE': 'django.db.backends.sqlite3',
            'NAME': BASE_DIR / 'db.sqlite3',
        }
    }

