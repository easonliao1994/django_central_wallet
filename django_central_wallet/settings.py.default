ALERT_DEDUP_SECONDS = int(os.getenv('ALERT_DEDUP_SECONDS', '3600'))  # repeat the same alert at most this often
ALERT_STUCK_MINUTES = int(os.getenv('ALERT_STUCK_MINUTES', '30'))  # approved/broadcast but not confirmed after this
ALERT_SCAN_LAG_BLOCKS = int(os.getenv('ALERT_SCAN_LAG_BLOCKS', '100'))  # scanner behind the confirmed head by more


