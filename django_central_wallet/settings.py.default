# Redis: Celery broker and shared cache (used for cross-worker task locks)
REDIS_URL = os.getenv('REDIS_URL', 'redis://localhost:6379/0')

CACHES = {
    'default': {
        'BACKEND': 'django.core.cache.backends.redis.RedisCache',
        'LOCATION': REDIS_URL,
    }
}
if len(sys.argv) > 1 and sys.argv[1] == 'test':
    # Tests need no Redis: throttles and task locks use an in-process cache.
    CACHES = {'default': {'BACKEND': 'django.core.cache.backends.locmem.LocMemCache'}}

# Celery
CELERY_BROKER_URL = os.getenv('CELERY_BROKER_URL', REDIS_URL)
CELERY_TIMEZONE = TIME_ZONE
CELERY_TASK_TRACK_STARTED = True
# Keep retrying the broker while Redis starts (Celery 6 changes the default).
CELERY_BROKER_CONNECTION_RETRY_ON_STARTUP = True
CELERY_BEAT_SCHEDULE = {
    # Fans out per-chain deposit scans and withdrawal processing.
    'dispatch-chain-jobs': {
        'task': 'blockchain.dispatch_chain_jobs',
        'schedule': 60.0,
    },
    # Looks for deposit addresses above their coin's sweep_threshold and starts sweeps.
    'sweep-deposits': {
        'task': 'blockchain.sweep_deposits',
        'schedule': 600.0,
    },
    'reconcile-balances': {
        'task': 'blockchain.reconcile_balances',
        'schedule': crontab(hour=3, minute=0),
    },
}


